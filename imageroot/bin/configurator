ls -1 apps >sites/apps.txt
bench set-config -g db_host "$DB_HOST"
bench set-config -gp db_port "$DB_PORT"
bench set-config -g redis_cache "redis://$REDIS_CACHE"
bench set-config -g redis_queue "redis://$REDIS_QUEUE"
bench set-config -g redis_socketio "redis://$REDIS_QUEUE"
bench set-config -gp socketio_port "$SOCKETIO_PORT"
bench set-config -g workers '{"sync": {"timeout": 300}, "build": {"timeout": 2400}}' -p
bench set-config -g dns_multitenant "true"

bench set-config -g allow_reads_during_maintenance "true"
bench set-config -g auto_update "false"
bench set-config -g background_workers "8"
bench set-config -g background_process_niceness "19"
bench set-config -g restart_supervisor_on_update "true"
bench set-config -g restart_systemd_on_update "false"
bench set-config -g scheduler_interval "300"
bench set-config -g scheduler_tick_interval "1"
bench set-config -g server_script_enabled "1"
bench set-config -g gunicorn_workers "32"
